{
  "name": "jev-mcp",
  "version": "0.1.0",
  "description": "MCP server that runs a browser goal with Jev and agentic-playwright-mcp.",
  "type": "module",
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "bin": {
    "jev": "./dist/cli.js",
    "jev-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./mcp": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "test": "tsc -p tsconfig.test.json --pretty false && node --test --test-timeout 20000 \"dist-test/**/*.test.js\"",
    "prepare": "tsc -p tsconfig.json --pretty false"
  },
  "keywords": [
    "jev",
    "mcp",
    "browser",
    "typesafe",
    "openrouter",
    "playwright",
    "agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.1",
    "@openrouter/sdk": "^1.3.17",
    "@typesafe-ai/sdk": "^0.6.0",
    "dotenv": "^16.6.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
