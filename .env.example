# Copy this file to .env, or run jev setup to write ~/.jev/.env

# official or openrouter
JEV_PROVIDER=openrouter

# Required when JEV_PROVIDER is openrouter. Also used to generate TYPE_TEXT.
OPENROUTER_API_KEY=

# Required when JEV_PROVIDER is official.
TYPESAFE_API_KEY=

# TYPESAFE_BASE_URL=https://openrouter.ai/api
# TYPESAFE_DEFAULT_MODEL=jev-1.13
# JEV_TEXT_MODEL=inception/mercury-2.5
# JEV_PLAYWRIGHT_CDP=http://127.0.0.1:9223
# JEV_LOAD_TIMEOUT_MS=8000
